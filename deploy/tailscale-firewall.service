# Docker가 올라온 뒤 Tailscale 방화벽 규칙을 적용한다 (재부팅 시 iptables 규칙이 사라지므로).
[Unit]
Description=BeWithYou - allow docker ports only from Tailscale
After=docker.service tailscaled.service
Requires=docker.service

[Service]
Type=oneshot
# tailscale ip가 할당될 때까지 잠시 기다린다
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do tailscale ip -4 >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/home/pi/BeWithYou-back/deploy/tailscale-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
