# PostgreSQL (호스트의 파이썬 프로세스 기준. fluent-bit 컨테이너는 compose에서 덮어씀)
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=bewithyou
PSQL_PASS=change-me
# DB의 time 컬럼 시간대
DB_TIMEZONE=Asia/Seoul

# Kafka (alerter.py)
KAFKA_BOOTSTRAP=localhost:9092
# 라즈베리파이의 Tailscale IPv4 주소 (`tailscale ip -4`).
# PostgreSQL/Kafka/Mosquitto는 localhost와 이 주소에만 공개된다.
TAILSCALE_IP=100.64.0.1

# 낙상 알림 MQTT 브로커 (alerter.py)
MQTT_HOST=osm-oracle.kro.kr
MQTT_PORT=7001
MQTT_USER=
MQTT_PASS=
MQTT_TLS=false
MQTT_TOPIC=alert
ALERT_COOLDOWN=30
# 최근 ALERT_WINDOW번(100ms 간격) 추론 중 ALERT_VOTES번 이상 낙상일 때만 알림
ALERT_WINDOW=10
ALERT_VOTES=5

# 라벨링용 카메라 수집(opencv.py)을 start.py에서 함께 띄울지
COLLECT_VIDEO=false

# 데이터 보존 기간(일, 0이면 지우지 않음). 라벨 앞뒤 LABEL_MARGIN_SECONDS초 신호는 남긴다
VIDEO_RETENTION_DAYS=14
SIGNAL_RETENTION_DAYS=30
LABEL_MARGIN_SECONDS=10

# CSI 트래픽용 ping (비우면 기본 게이트웨이, 10ms 간격)
CSI_PING_TARGET=
CSI_PING_INTERVAL=0.01
