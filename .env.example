# PostgreSQL (호스트의 파이썬 프로세스 기준. fluent-bit 컨테이너는 compose에서 덮어씀)
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=bewithyou
PSQL_PASS=change-me
# DB의 time 컬럼 시간대
DB_TIMEZONE=Asia/Seoul

# Kafka (alerter.py)
KAFKA_BOOTSTRAP=localhost:9092
# 라즈베리파이의 Tailscale IPv4 주소 (`tailscale ip -4`).
# PostgreSQL/Kafka/Mosquitto는 localhost와 이 주소에만 공개된다.
TAILSCALE_IP=100.64.0.1

# 낙상 알림 MQTT 브로커 (alerter.py)
MQTT_HOST=osm-oracle.kro.kr
MQTT_PORT=7001
MQTT_USER=
MQTT_PASS=
MQTT_TLS=false
MQTT_TOPIC=alert
ALERT_COOLDOWN=30
