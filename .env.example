# PostgreSQL (호스트의 파이썬 프로세스 기준. fluent-bit 컨테이너는 compose에서 덮어씀)
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=bewithyou
PSQL_PASS=change-me
# DB의 time 컬럼 시간대
DB_TIMEZONE=Asia/Seoul

# Kafka (alerter.py)
KAFKA_BOOTSTRAP=localhost:9092
# 다른 PC에서 Kafka에 접속할 때 브로커가 알려줄 호스트명 (예: deeprasp)
KAFKA_ADVERTISED_HOST=localhost
